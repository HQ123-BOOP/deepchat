{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chat-demo",
  "version": "0.1.1",
  "identifier": "com.hq123boop.chatdemo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chat-demo",
        "width": 1200,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
